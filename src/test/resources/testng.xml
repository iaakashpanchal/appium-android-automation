<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Appium Android Regression Suite" verbose="1">

    <listeners>
        <listener class-name="com.qa.utils.TestListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="com.qa.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Search Tests">
        <classes>
            <class name="com.qa.tests.SearchTest"/>
        </classes>
    </test>

</suite>
